# Copy values into your shell before starting uvicorn, e.g.:
#   $env:GEMINI_API_KEY = "..."
#
# Priority: GEMINI > GROQ > OPENAI > local excerpts

# Free — Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# OCR for scanned PDFs (uses Gemini vision if Tesseract is not installed)
# OCR_ENABLED=true
# OCR_MIN_CHARS=80
# OCR_MAX_PAGES=20
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Free alternative — Groq: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Optional paid
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
