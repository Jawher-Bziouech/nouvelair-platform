# Database
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/nouvelair

# JWT
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM providers - configure at least one for generated answers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OCR
OCR_ENABLED=true
OCR_MIN_CHARS=80
OCR_MAX_PAGES=20
OCR_DPI=200
TESSERACT_CMD=
